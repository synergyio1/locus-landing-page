{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_01JTo2CPFhsbFTJJyr2UVdMH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011BSdJQNrjCaDKhPJTBeWu9","name":"Write","input":{"file_path":"/Users/cippa/Desktop/fly/locus-landing-page-preview/src/lib/stripe/client.ts","content":"import \"server-only\"\n\nimport Stripe from \"stripe\"\n\nlet cached: Stripe | null = null\n\nexport function getStripeClient(): Stripe {\n  if (cached) return cached\n\n  const secret = process.env.STRIPE_SECRET_KEY\n  if (!secret) {\n    throw new Error(\"STRIPE_SECRET_KEY is not configured\")\n  }\n\n  cached = new Stripe(secret, {\n    apiVersion: \"2024-12-18.acacia\" as Stripe.LatestApiVersion,\n  })\n  return cached\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":573,"cache_read_input_tokens":82936,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":573},"output_tokens":53,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b359056d-8171-4758-80a4-d865a9a6082e","uuid":"430e027d-2b30-47b9-a0b6-172f595dfb9b"}
