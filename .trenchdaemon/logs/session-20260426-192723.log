{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015tg8Ywk7Fw653jtLKRoFCB","type":"tool_result","content":"1\timport \"server-only\"\n2\t\n3\timport type { SupabaseClient } from \"@supabase/supabase-js\"\n4\t\n5\texport type Plan = \"free\" | \"trial\" | \"pro\"\n6\t\n7\texport type SubscriptionStatus =\n8\t  | \"active\"\n9\t  | \"canceled\"\n10\t  | \"incomplete\"\n11\t  | \"incomplete_expired\"\n12\t  | \"past_due\"\n13\t  | \"trialing\"\n14\t  | \"unpaid\"\n15\t  | \"paused\"\n16\t\n17\texport type Entitlement = {\n18\t  user_id: string\n19\t  plan: Plan\n20\t}\n21\t\n22\texport type Subscription = {\n23\t  user_id: string\n24\t  status: SubscriptionStatus | string\n25\t  current_period_end: string | null\n26\t  cancel_at: string | null\n27\t  price_id: string | null\n28\t}\n29\t\n30\texport type Profile = {\n31\t  user_id: string\n32\t  email: string\n33\t}\n34\t\n35\texport type ProTrial = {\n36\t  user_id: string\n37\t  started_at: string\n38\t  expires_at: string\n39\t}\n40\t\n41\texport type AccountSnapshot = {\n42\t  email: string\n43\t  entitlement: Entitlement | null\n44\t  subscription: Subscription | null\n45\t  proTrial: ProTrial | null\n46\t}\n47\t\n48\texport async function loadAccountSnapshot(\n49\t  supabase: SupabaseClient,\n50\t  userId: string,\n51\t  fallbackEmail: string\n52\t): Promise<AccountSnapshot> {\n53\t  const [entitlement, subscription, profile, proTrial] = await Promise.all([\n54\t    supabase\n55\t      .from(\"entitlements_v\")\n56\t      .select(\"user_id, plan\")\n57\t      .eq(\"user_id\", userId)\n58\t      .maybeSingle<Entitlement>(),\n59\t    supabase\n60\t      .from(\"subscriptions\")\n61\t      .select(\"user_id, status, current_period_end, cancel_at, price_id\")\n62\t      .eq(\"user_id\", userId)\n63\t      .maybeSingle<Subscription>(),\n64\t    supabase\n65\t      .from(\"profiles\")\n66\t      .select(\"user_id, email\")\n67\t      .eq(\"user_id\", userId)\n68\t      .maybeSingle<Profile>(),\n69\t    supabase\n70\t      .from(\"pro_trials\")\n71\t      .select(\"user_id, started_at, expires_at\")\n72\t      .eq(\"user_id\", userId)\n73\t      .maybeSingle<ProTrial>(),\n74\t  ])\n75\t\n76\t  return {\n77\t    email: profile.data?.email ?? fallbackEmail,\n78\t    entitlement: entitlement.data ?? null,\n79\t    subscription: subscription.data ?? null,\n80\t    proTrial: proTrial.data ?? null,\n81\t  }\n82\t}\n83\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01KHTbDzWtEZXsH1hqvL3bHR","session_id":"b359056d-8171-4758-80a4-d865a9a6082e","uuid":"b407382f-05ce-4e33-9e18-60c78b51597b","timestamp":"2026-04-26T22:28:10.068Z"}
