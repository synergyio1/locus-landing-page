{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_01EBP6mFFiUbMxWR5hiNKviX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019YZGpZ7Wv5t1GUDXoF34uZ","name":"Write","input":{"file_path":"/Users/cippa/Desktop/fly/locus-landing-page-preview/src/lib/stripe/checkout.ts","content":"import \"server-only\"\n\nimport type { SupabaseClient } from \"@supabase/supabase-js\"\n\nimport { getStripeClient } from \"./client\"\nimport { getOrCreateCustomer } from \"./customer\"\n\nexport type CreateCheckoutSessionParams = {\n  supabase: SupabaseClient\n  userId: string\n  email: string\n  priceId: string\n  origin: string\n}\n\nexport async function createCheckoutSession({\n  supabase,\n  userId,\n  email,\n  priceId,\n  origin,\n}: CreateCheckoutSessionParams): Promise<{ url: string }> {\n  const customerId = await getOrCreateCustomer({ supabase, userId, email })\n\n  const stripe = getStripeClient()\n  const session = await stripe.checkout.sessions.create({\n    mode: \"subscription\",\n    customer: customerId,\n    line_items: [{ price: priceId, quantity: 1 }],\n    client_reference_id: userId,\n    success_url: `${origin}/account?welcome=1`,\n    cancel_url: `${origin}/pricing`,\n  })\n\n  if (!session.url) {\n    throw new Error(\"Stripe Checkout did not return a redirect URL\")\n  }\n\n  return { url: session.url }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":734,"cache_read_input_tokens":84038,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":734},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b359056d-8171-4758-80a4-d865a9a6082e","uuid":"201d897d-dc27-45d4-aa8d-451cf9b8ad05"}
