{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QR1kTosDqVMs3TF1ujNaLX","type":"tool_result","content":"1\timport { NextResponse, type NextRequest } from \"next/server\"\n2\t\n3\timport { createServerClient } from \"@/lib/supabase/server\"\n4\t\n5\tfunction resolveNext(\n6\t  nextParam: string | null,\n7\t  requestUrl: string\n8\t): URL {\n9\t  const fallback = new URL(\"/account\", requestUrl)\n10\t  if (!nextParam) return fallback\n11\t\n12\t  try {\n13\t    const candidate = new URL(nextParam, requestUrl)\n14\t    if (candidate.origin !== new URL(requestUrl).origin) return fallback\n15\t    return candidate\n16\t  } catch {\n17\t    return fallback\n18\t  }\n19\t}\n20\t\n21\texport async function GET(request: NextRequest) {\n22\t  const { searchParams } = request.nextUrl\n23\t  const code = searchParams.get(\"code\")\n24\t  const nextParam = searchParams.get(\"next\")\n25\t\n26\t  if (!code) {\n27\t    const loginUrl = new URL(\"/login\", request.url)\n28\t    loginUrl.searchParams.set(\"error\", \"missing_code\")\n29\t    return NextResponse.redirect(loginUrl, 302)\n30\t  }\n31\t\n32\t  const supabase = await createServerClient()\n33\t  const { error } = await supabase.auth.exchangeCodeForSession(code)\n34\t\n35\t  if (error) {\n36\t    const loginUrl = new URL(\"/login\", request.url)\n37\t    loginUrl.searchParams.set(\"error\", \"exchange_failed\")\n38\t    return NextResponse.redirect(loginUrl, 302)\n39\t  }\n40\t\n41\t  return NextResponse.redirect(resolveNext(nextParam, request.url), 302)\n42\t}\n43\t"}]},"parent_tool_use_id":null,"session_id":"b359056d-8171-4758-80a4-d865a9a6082e","uuid":"9a198c8c-f681-4177-af22-03004211302b","timestamp":"2026-04-26T22:29:47.728Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cippa/Desktop/fly/locus-landing-page-preview/src/app/auth/callback/route.ts","content":"import { NextResponse, type NextRequest } from \"next/server\"\n\nimport { createServerClient } from \"@/lib/supabase/server\"\n\nfunction resolveNext(\n  nextParam: string | null,\n  requestUrl: string\n): URL {\n  const fallback = new URL(\"/account\", requestUrl)\n  if (!nextParam) return fallback\n\n  try {\n    const candidate = new URL(nextParam, requestUrl)\n    if (candidate.origin !== new URL(requestUrl).origin) return fallback\n    return candidate\n  } catch {\n    return fallback\n  }\n}\n\nexport async function GET(request: NextRequest) {\n  const { searchParams } = request.nextUrl\n  const code = searchParams.get(\"code\")\n  const nextParam = searchParams.get(\"next\")\n\n  if (!code) {\n    const loginUrl = new URL(\"/login\", request.url)\n    loginUrl.searchParams.set(\"error\", \"missing_code\")\n    return NextResponse.redirect(loginUrl, 302)\n  }\n\n  const supabase = await createServerClient()\n  const { error } = await supabase.auth.exchangeCodeForSession(code)\n\n  if (error) {\n    const loginUrl = new URL(\"/login\", request.url)\n    loginUrl.searchParams.set(\"error\", \"exchange_failed\")\n    return NextResponse.redirect(loginUrl, 302)\n  }\n\n  return NextResponse.redirect(resolveNext(nextParam, request.url), 302)\n}\n","numLines":43,"startLine":1,"totalLines":43}}}
