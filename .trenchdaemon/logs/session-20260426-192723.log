{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019rhVxJ3jDjRVeBuS8W93xE","type":"tool_result","content":"1\timport \"server-only\"\n2\t\n3\timport type { SupabaseClient } from \"@supabase/supabase-js\"\n4\t\n5\texport type Plan = \"free\" | \"trial\" | \"pro\"\n6\t\n7\texport type SubscriptionStatus =\n8\t  | \"active\"\n9\t  | \"canceled\"\n10\t  | \"incomplete\"\n11\t  | \"incomplete_expired\"\n12\t  | \"past_due\"\n13\t  | \"trialing\"\n14\t  | \"unpaid\"\n15\t  | \"paused\"\n16\t\n17\texport type Entitlement = {\n18\t  user_id: string\n19\t  plan: Plan\n20\t}\n21\t\n22\texport type Subscription = {\n23\t  user_id: string\n24\t  status: SubscriptionStatus | string\n25\t  current_period_end: string | null\n26\t  cancel_at: string | null\n27\t  price_id: string | null\n28\t}\n29\t\n30\texport type Profile = {\n31\t  user_id: string\n32\t  email: string\n33\t}\n34\t\n35\texport type ProTrial = {\n36\t  user_id: string\n37\t  started_at: string\n38\t  expires_at: string\n39\t}\n40\t\n41\texport type AccountSnapshot = {\n42\t  email: string\n43\t  entitlement: Entitlement | null\n44\t  subscription: Subscription | null\n45\t  proTrial: ProTrial | null\n46\t}\n47\t\n48\texport async function loadAccountSnapshot(\n49\t  supabase: SupabaseClient,\n50\t  userId: string,\n51\t  fallbackEmail: string\n52\t): Promise<AccountSnapshot> {\n53\t  const [entitlement, subscription, profile, proTrial] = await Promise.all([\n54\t    supabase\n55\t      .from(\"entitlements_v\")\n56\t      .select(\"user_id, plan\")\n57\t      .eq(\"user_id\", userId)\n58\t      .maybeSingle<Entitlement>(),\n59\t    supabase\n60\t      .from(\"subscriptions\")\n61\t      .select(\"user_id, status, current_period_end, cancel_at, price_id\")\n62\t      .eq(\"user_id\", userId)\n63\t      .maybeSingle<Subscription>(),\n64\t    supabase\n65\t      .from(\"profiles\")\n66\t      .select(\"user_id, email\")\n67\t      .eq(\"user_id\", userId)\n68\t      .maybeSingle<Profile>(),\n69\t    supabase\n70\t      .from(\"pro_trials\")\n71\t      .select(\"user_id, started_at, expires_at\")\n72\t      .eq(\"user_id\", userId)\n73\t      .maybeSingle<ProTrial>(),\n74\t  ])\n75\t\n76\t  return {\n77\t    email: profile.data?.email ?? fallbackEmail,\n78\t    entitlement: entitlement.data ?? null,\n79\t    subscription: subscription.data ?? null,\n80\t    proTrial: proTrial.data ?? null,\n81\t  }\n82\t}\n83\t"}]},"parent_tool_use_id":null,"session_id":"b359056d-8171-4758-80a4-d865a9a6082e","uuid":"0cde0c7a-5a73-41e3-9ad5-8ca0bb85b1cc","timestamp":"2026-04-26T22:29:24.463Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cippa/Desktop/fly/locus-landing-page-preview/src/lib/account/snapshot.ts","content":"import \"server-only\"\n\nimport type { SupabaseClient } from \"@supabase/supabase-js\"\n\nexport type Plan = \"free\" | \"trial\" | \"pro\"\n\nexport type SubscriptionStatus =\n  | \"active\"\n  | \"canceled\"\n  | \"incomplete\"\n  | \"incomplete_expired\"\n  | \"past_due\"\n  | \"trialing\"\n  | \"unpaid\"\n  | \"paused\"\n\nexport type Entitlement = {\n  user_id: string\n  plan: Plan\n}\n\nexport type Subscription = {\n  user_id: string\n  status: SubscriptionStatus | string\n  current_period_end: string | null\n  cancel_at: string | null\n  price_id: string | null\n}\n\nexport type Profile = {\n  user_id: string\n  email: string\n}\n\nexport type ProTrial = {\n  user_id: string\n  started_at: string\n  expires_at: string\n}\n\nexport type AccountSnapshot = {\n  email: string\n  entitlement: Entitlement | null\n  subscription: Subscription | null\n  proTrial: ProTrial | null\n}\n\nexport async function loadAccountSnapshot(\n  supabase: SupabaseClient,\n  userId: string,\n  fallbackEmail: string\n): Promise<AccountSnapshot> {\n  const [entitlement, subscription, profile, proTrial] = await Promise.all([\n    supabase\n      .from(\"entitlements_v\")\n      .select(\"user_id, plan\")\n      .eq(\"user_id\", userId)\n      .maybeSingle<Entitlement>(),\n    supabase\n      .from(\"subscriptions\")\n      .select(\"user_id, status, current_period_end, cancel_at, price_id\")\n      .eq(\"user_id\", userId)\n      .maybeSingle<Subscription>(),\n    supabase\n      .from(\"profiles\")\n      .select(\"user_id, email\")\n      .eq(\"user_id\", userId)\n      .maybeSingle<Profile>(),\n    supabase\n      .from(\"pro_trials\")\n      .select(\"user_id, started_at, expires_at\")\n      .eq(\"user_id\", userId)\n      .maybeSingle<ProTrial>(),\n  ])\n\n  return {\n    email: profile.data?.email ?? fallbackEmail,\n    entitlement: entitlement.data ?? null,\n    subscription: subscription.data ?? null,\n    proTrial: proTrial.data ?? null,\n  }\n}\n","numLines":83,"startLine":1,"totalLines":83}}}
