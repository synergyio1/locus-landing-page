{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TaEnfVoLYxpR836MqPFQB4","type":"tool_result","content":"1\timport { describe, it, expect, vi, beforeEach } from \"vitest\"\n2\timport { NextRequest } from \"next/server\"\n3\t\n4\tconst exchangeCodeForSession = vi.fn()\n5\t\n6\tvi.mock(\"@/lib/supabase/server\", () => ({\n7\t  createServerClient: async () => ({\n8\t    auth: {\n9\t      exchangeCodeForSession,\n10\t    },\n11\t  }),\n12\t}))\n13\t\n14\timport { GET } from \"./route\"\n15\t\n16\tdescribe(\"GET /auth/callback\", () => {\n17\t  beforeEach(() => {\n18\t    exchangeCodeForSession.mockReset()\n19\t  })\n20\t\n21\t  it(\"exchanges the code for a session and redirects to next param\", async () => {\n22\t    exchangeCodeForSession.mockResolvedValue({ data: {}, error: null })\n23\t\n24\t    const request = new NextRequest(\n25\t      new URL(\"http://localhost:3000/auth/callback?code=abc123&next=/billing\")\n26\t    )\n27\t    const response = await GET(request)\n28\t\n29\t    expect(exchangeCodeForSession).toHaveBeenCalledWith(\"abc123\")\n30\t    expect(response.status).toBe(302)\n31\t    expect(new URL(response.headers.get(\"location\")!).pathname).toBe(\"/billing\")\n32\t  })\n33\t\n34\t  it(\"defaults to /account when no next param is given\", async () => {\n35\t    exchangeCodeForSession.mockResolvedValue({ data: {}, error: null })\n36\t\n37\t    const request = new NextRequest(\n38\t      new URL(\"http://localhost:3000/auth/callback?code=abc123\")\n39\t    )\n40\t    const response = await GET(request)\n41\t\n42\t    expect(response.status).toBe(302)\n43\t    expect(new URL(response.headers.get(\"location\")!).pathname).toBe(\"/account\")\n44\t  })\n45\t\n46\t  it(\"redirects to /login with an error when code is missing\", async () => {\n47\t    const request = new NextRequest(\n48\t      new URL(\"http://localhost:3000/auth/callback\")\n49\t    )\n50\t    const response = await GET(request)\n51\t\n52\t    expect(exchangeCodeForSession).not.toHaveBeenCalled()\n53\t    expect(response.status).toBe(302)\n54\t    const redirect = new URL(response.headers.get(\"location\")!)\n55\t    expect(redirect.pathname).toBe(\"/login\")\n56\t    expect(redirect.searchParams.get(\"error\")).toBeTruthy()\n57\t  })\n58\t\n59\t  it(\"redirects to /login with an error when exchange fails\", async () => {\n60\t    exchangeCodeForSession.mockResolvedValue({\n61\t      data: null,\n62\t      error: { message: \"invalid_grant\" },\n63\t    })\n64\t\n65\t    const request = new NextRequest(\n66\t      new URL(\"http://localhost:3000/auth/callback?code=bad\")\n67\t    )\n68\t    const response = await GET(request)\n69\t\n70\t    expect(response.status).toBe(302)\n71\t    const redirect = new URL(response.headers.get(\"location\")!)\n72\t    expect(redirect.pathname).toBe(\"/login\")\n73\t    expect(redirect.searchParams.get(\"error\")).toBeTruthy()\n74\t  })\n75\t\n76\t  it(\"rejects next values pointing to a different origin\", async () => {\n77\t    exchangeCodeForSession.mockResolvedValue({ data: {}, error: null })\n78\t\n79\t    const request = new NextRequest(\n80\t      new URL(\n81\t        \"http://localhost:3000/auth/callback?code=abc&next=https://evil.example.com/steal\"\n82\t      )\n83\t    )\n84\t    const response = await GET(request)\n85\t\n86\t    expect(response.status).toBe(302)\n87\t    const redirect = new URL(response.headers.get(\"location\")!)\n88\t    expect(redirect.origin).toBe(\"http://localhost:3000\")\n89\t    expect(redirect.pathname).toBe(\"/account\")\n90\t  })\n91\t})\n92\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01KHTbDzWtEZXsH1hqvL3bHR","session_id"