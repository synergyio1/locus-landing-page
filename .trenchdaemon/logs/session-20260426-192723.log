{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qfyxsxhj3fp2tgEHoDyeaY","type":"tool_result","content":"1\t\"use client\"\n2\t\n3\timport { useState } from \"react\"\n4\t\n5\timport { createBrowserClient } from \"@/lib/supabase/browser\"\n6\t\n7\ttype LoginFormProps = {\n8\t  next: string\n9\t  errorMessage?: string\n10\t}\n11\t\n12\ttype Status =\n13\t  | { kind: \"idle\" }\n14\t  | { kind: \"sending\" }\n15\t  | { kind: \"sent\" }\n16\t  | { kind: \"error\"; message: string }\n17\t\n18\tfunction buildRedirectUrl(next: string): string {\n19\t  const origin =\n20\t    (typeof window !== \"undefined\" && window.location.origin) ||\n21\t    process.env.NEXT_PUBLIC_SITE_URL ||\n22\t    \"\"\n23\t  const url = new URL(\"/auth/callback\", origin || \"http://localhost\")\n24\t  url.searchParams.set(\"next\", next)\n25\t  return url.toString()\n26\t}\n27\t\n28\texport function LoginForm({ next, errorMessage }: LoginFormProps) {\n29\t  const [status, setStatus] = useState<Status>({ kind: \"idle\" })\n30\t  const [email, setEmail] = useState(\"\")\n31\t\n32\t  async function signInWithProvider(provider: \"google\" | \"apple\") {\n33\t    setStatus({ kind: \"sending\" })\n34\t    const supabase = createBrowserClient()\n35\t    const { error } = await supabase.auth.signInWithOAuth({\n36\t      provider,\n37\t      options: { redirectTo: buildRedirectUrl(next) },\n38\t    })\n39\t    if (error) setStatus({ kind: \"error\", message: error.message })\n40\t  }\n41\t\n42\t  async function sendMagicLink(event: React.FormEvent<HTMLFormElement>) {\n43\t    event.preventDefault()\n44\t    setStatus({ kind: \"sending\" })\n45\t    const supabase = createBrowserClient()\n46\t    const { error } = await supabase.auth.signInWithOtp({\n47\t      email,\n48\t      options: { emailRedirectTo: buildRedirectUrl(next) },\n49\t    })\n50\t    if (error) {\n51\t      setStatus({ kind: \"error\", message: error.message })\n52\t      return\n53\t    }\n54\t    setStatus({ kind: \"sent\" })\n55\t  }\n56\t\n57\t  const disabled = status.kind === \"sending\"\n58\t\n59\t  return (\n60\t    <div className=\"mx-auto w-full max-w-sm space-y-6\">\n61\t      {errorMessage ? (\n62\t        <p role=\"alert\" className=\"rounded-md bg-red-50 px-3 py-2 text-sm text-red-900\">\n63\t          {errorMessage}\n64\t        </p>\n65\t      ) : null}\n66\t\n67\t      <div className=\"grid gap-3\">\n68\t        <button\n69\t          type=\"button\"\n70\t          onClick={() => signInWithProvider(\"google\")}\n71\t          disabled={disabled}\n72\t          className=\"inline-flex w-full items-center justify-center rounded-md border border-[var(--fg)]/20 px-4 py-2 text-sm font-medium transition hover:bg-[var(--fg)]/5 disabled:opacity-50\"\n73\t        >\n74\t          Continue with Google\n75\t        </button>\n76\t        <button\n77\t          type=\"button\"\n78\t          onClick={() => signInWithProvider(\"apple\")}\n79\t          disabled={disabled}\n80\t          className=\"inline-flex w-full items-center justify-center rounded-md border border-[var(--fg)]/20 px-4 py-2 text-sm font-medium transition hover:bg-[var(--fg)]/5 disabled:opacity-50\"\n81\t        >\n82\t          Continue with Apple\n83\t        </button>\n84\t      </div>\n85\t\n86\t      <div className=\"flex items-center gap-3 text-xs uppercase tracking-wide text-[var(--fg)]/50\">\n87\t        <span className=\"h-px flex-1 bg-[var(--fg)]/15\" />\n88\t        or\n89\t        <span className=\"h-px flex-1 bg-[var(--fg)]/15\" />\n90\t      </div>\n91\t\n92\t      <form onSubmit={sendMagicLink} className=\"grid gap-3\">\n93\t        <label className=\"grid gap-1 text-sm\">\n94\t          <span>Email</span>\n95\t          <input\n96\t            type=\"email\"\n97\t            required\n98\t            value={email}\n99\t            onChange={(e) => setEmail(e.target.value)}\n100\t            disabled={disabled}\n101\t            autoComplete=\"email\"\n102\t            className=\"rounded-md border border-[var(--fg)]/20 bg-transparent px-3 py-2 text-sm outline-none focus:border-[var(--fg)]/50\"\n103\t          />\n104\t        </label>\n105\t        <button\n106\t          type=\"submit\"\n107\t          disabled={disabled || email.length === 0}\n108\t          className=\"inline-flex w-full items-center justify-center rounded-md bg-[#0047AB] px-4 py-2 text-sm font-medium text-white transition hover:opacity-90 disabled:opacity-50\"\n109\t        >\n110\t          {status.kind === \"sending\" ? \"Sending…\" : \"Send magic link\"}\n111\t        </button>\n112\t      </form>\n113\t\n114\t      {status.kind === \"sent\" ? (\n115\t        <p role=\"status\" className=\"text-sm text-[var(--fg)]/70\">\n116\t          Check your email for a sign-in link.\n117\t        </p>\n118\t      ) : null}\n119\t      {status.kind === \"error\" ? (\n120\t        <p role=\"alert\" className=\"text-sm text-red-600\">\n121\t          {status.message}\n122\t        </p>\n123\t      ) : null}\n124\t    </div>\n125\t  )\n126\t}\n127\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01KHTbDzWtEZXsH1hqvL3bHR","session_id":"b359056d-8171-4758-80a4-d865a9a6082e","uuid":"15cef248-3d65-4161-9a07-85152f1df52f","timestamp":"2026-04-26T22:28:35.875Z"}
