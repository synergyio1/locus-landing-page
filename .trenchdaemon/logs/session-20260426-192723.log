{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017SY77NSfPLhKKwBSA2eG3X","type":"tool_result","content":"1\timport { afterEach, describe, it, expect, vi } from \"vitest\"\n2\timport { cleanup, render, screen } from \"@testing-library/react\"\n3\t\n4\timport type { AccountSnapshot } from \"@/lib/account/snapshot\"\n5\t\n6\tconst authState: { user: { id: string; email: string } | null } = { user: null }\n7\tconst snapshotState: { snapshot: AccountSnapshot | null } = { snapshot: null }\n8\t\n9\tvi.mock(\"@/lib/supabase/server\", () => ({\n10\t  createServerClient: async () => ({\n11\t    auth: {\n12\t      getUser: async () => ({\n13\t        data: { user: authState.user },\n14\t        error: null,\n15\t      }),\n16\t    },\n17\t  }),\n18\t}))\n19\t\n20\tvi.mock(\"@/lib/account/snapshot\", () => ({\n21\t  loadAccountSnapshot: async () => snapshotState.snapshot,\n22\t}))\n23\t\n24\tvi.mock(\"next/navigation\", () => ({\n25\t  redirect: (url: string) => {\n26\t    throw new Error(`NEXT_REDIRECT: ${url}`)\n27\t  },\n28\t  useRouter: () => ({ push: vi.fn(), refresh: vi.fn() }),\n29\t}))\n30\t\n31\timport AccountPage from \"./page\"\n32\t\n33\tconst baseUser = { id: \"u1\", email: \"cook@example.com\" }\n34\t\n35\tfunction setSnapshot(snapshot: AccountSnapshot) {\n36\t  authState.user = baseUser\n37\t  snapshotState.snapshot = snapshot\n38\t}\n39\t\n40\tdescribe(\"AccountPage\", () => {\n41\t  afterEach(() => {\n42\t    cleanup()\n43\t    authState.user = null\n44\t    snapshotState.snapshot = null\n45\t  })\n46\t\n47\t  it(\"redirects unauthenticated users to /login?next=/account\", async () => {\n48\t    authState.user = null\n49\t    await expect(AccountPage()).rejects.toThrow(\n50\t      \"NEXT_REDIRECT: /login?next=/account\"\n51\t    )\n52\t  })\n53\t\n54\t  it(\"renders Free chip + Upgrade + Start-trial CTA for a new free user\", async () => {\n55\t    setSnapshot({\n56\t      email: \"cook@example.com\",\n57\t      entitlement: { user_id: \"u1\", plan: \"free\" },\n58\t      subscription: null,\n59\t      proTrial: null,\n60\t    })\n61\t\n62\t    const jsx = await AccountPage()\n63\t    render(jsx)\n64\t\n65\t    expect(screen.getByText(\"cook@example.com\")).toBeTruthy()\n66\t    expect(screen.getByTestId(\"plan-chip\").textContent).toBe(\"Free\")\n67\t    expect(\n68\t      (screen.getByRole(\"button\", {\n69\t        name: /upgrade to pro/i,\n70\t      }) as HTMLButtonElement).disabled\n71\t    ).toBe(true)\n72\t    expect(\n73\t      (screen.getByRole(\"button\", {\n74\t        name: /start 7-day pro trial/i,\n75\t      }) as HTMLButtonElement).disabled\n76\t    ).toBe(true)\n77\t  })\n78\t\n79\t  it(\"renders 'Trial used on <date>' for a free user who consumed their trial\", async () => {\n80\t    setSnapshot({\n81\t      email: \"cook@example.com\",\n82\t      entitlement: { user_id: \"u1\", plan: \"free\" },\n83\t      subscription: null,\n84\t      proTrial: {\n85\t        user_id: \"u1\",\n86\t        started_at: \"2026-04-01T12:00:00.000Z\",\n87\t        expires_at: \"2026-04-08T12:00:00.000Z\",\n88\t      },\n89\t    })\n90\t\n91\t    const jsx = await AccountPage()\n92\t    render(jsx)\n93\t\n94\t    expect(screen.getByTestId(\"plan-chip\").textContent).toBe(\"Free\")\n95\t    const trialButton = screen.getByRole(\"button\", {\n96\t      name: /trial used on/i,\n97\t    }) as HTMLButtonElement\n98\t    expect(trialButton.disabled).toBe(true)\n99\t    expect(trialButton.textContent).toContain(\"April 1, 2026\")\n100\t    expect(\n101\t      screen.queryByRole(\"button\", { name: /start 7-day pro trial/i })\n102\t    ).toBeNull()\n103\t  })\n104\t\n105\t  it(\"renders Trial chip with expiry date for an active trial\", async () => {\n106\t    setSnapshot({\n107\t      email: \"cook@example.com\",\n108\t      entitlement: { user_id: \"u1\", plan: \"trial\" },\n109\t      subscription: null,\n110\t      proTrial: {\n111\t        user_id: \"u1\",\n112\t        started_at: \"2026-04-23T12:00:00.000Z\",\n113\t        expires_at: \"2026-04-30T12:00:00.000Z\",\n114\t      },\n115\t    })\n116\t\n117\t    const jsx = await AccountPage()\n118\t    render(jsx)\n119\t\n120\t    expect(screen.getByTestId(\"plan-chip\").textContent).toBe(\"Trial\")\n121\t    expect(screen.getByText(/trial expires april 30, 2026/i)).toBeTruthy()\n122\t    expect(\n123\t      screen.queryByRole(\"button\", { name: /start 7-day pro trial/i })\n124\t    ).toBeNull()\n125\t    expect(\n126\t      screen.queryByRole(\"button\", { name: /trial used on/i })\n127\t    ).toBeNull()\n128\t  })\n129\t\n130\t  it(\"renders Pro chip with renewal date for an active subscription\", async () => {\n131\t    setSnapshot({\n132\t      email: \"cook@example.com\",\n133\t      entitlement: { user_id: \"u1\", plan: \"pro\" },\n134\t      subscription: {\n135\t        user_id: \"u1\",\n136\t        status: \"active\",\n137\t        current_period_end: \"2026-05-25T12:00:00.000Z\",\n138\t        cancel_at: null,\n139\t        price_id: \"price_monthly\",\n140\t      },\n141\t      proTrial: null,\n142\t    })\n143\t\n144\t    const jsx = await AccountPage()\n145\t    render(jsx)\n146\t\n147\t    expect(screen.getByTestId(\"plan-chip\").textContent).toBe(\"Pro\")\n148\t    expect(screen.getByText(/renews on may 25, 2026/i)).toBeTruthy()\n149\t    expect(\n150\t      (screen.getByRole(\"button\", {\n151\t        name: /manage subscription/i,\n152\t      }) as HTMLButtonElement).disabled\n153\t    ).toBe(true)\n154\t    expect(\n155\t      screen.queryByRole(\"button\", { name: /upgrade to pro/i })\n156\t    ).toBeNull()\n157\t  })\n158\t\n159\t  it(\"renders 'Pro until <date>, will not renew' when subscription is cancelling\", async () => {\n160\t    setSnapshot({\n161\t      email: \"cook@example.com\",\n162\t      entitlement: { user_id: \"u1\", plan: \"pro\" },\n163\t      subscription: {\n164\t        user_id: \"u1\",\n165\t        status: \"active\",\n166\t        current_period_end: \"2026-05-25T12:00:00.000Z\",\n167\t        cancel_at: \"2026-05-25T12:00:00.000Z\",\n168\t        price_id: \"price_monthly\",\n169\t      },\n170\t      proTrial: null,\n171\t    })\n172\t\n173\t    const jsx = await AccountPage()\n174\t    render(jsx)\n175\t\n176\t    expect(screen.getByTestId(\"plan-chip\").textContent).toBe(\"Pro\")\n177\t    expect(\n178\t      screen.getByText(/pro until may 25, 2026, will not renew/i)\n179\t    ).toBeTruthy()\n180\t  })\n181\t\n182\t  it(\"links to /download\", async () => {\n183\t    setSnapshot({\n184\t      email: \"cook@example.com\",\n185\t      entitlement: { user_id: \"u1\", plan: \"free\" },\n186\t      subscription: null,\n187\t      proTrial: null,\n188\t    })\n189\t\n190\t    const jsx = await AccountPage()\n191\t    render(jsx)\n192\t\n193\t    const link = screen.getByRole(\"link\", { name: /download locus for mac/i })\n194\t    expect(link.getAttribute(\"href\")).toBe(\"/download\")\n195\t  })\n196\t\n197\t  it(\"retains the 'Sign out everywhere' button\", async () => {\n198\t    setSnapshot({\n199\t      email: \"cook@example.com\",\n200\t      entitlement: { user_id: \"u1\", plan: \"free\" },\n201\t      subscription: null,\n202\t      proTrial: null,\n203\t    })\n204\t\n205\t    const jsx = await AccountPage()\n206\t    render(jsx)\n207\t\n208\t    expect(\n209\t      screen.getByRole(\"button\", { name: /sign out everywhere/i })\n210\t    ).toBeTruthy()\n211\t  })\n212\t})\n213\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01KHTbDzWtEZXsH1hqvL3bHR","session_id":"b359056d-8171-4758-80a4-d865a9a6082e","uuid":"088eb6da-1033-4c36-9da2-a76585bce2af","timestamp":"2026-04-26T22:28:26.780Z"}
