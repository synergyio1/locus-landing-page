{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cbp4E8UgKMQEkCx1A3hxNB","type":"tool_result","content":"1\timport type { AccountSnapshot, Plan } from \"./snapshot\"\n2\t\n3\texport type PlanLabel = \"Free\" | \"Trial\" | \"Pro\"\n4\t\n5\texport type AccountView = {\n6\t  email: string\n7\t  plan: Plan\n8\t  planLabel: PlanLabel\n9\t  dateLine: string | null\n10\t  primaryCta: { label: \"Upgrade to Pro\" | \"Manage subscription\" }\n11\t  trialCta:\n12\t    | { kind: \"start\"; label: string }\n13\t    | { kind: \"used\"; label: string }\n14\t    | null\n15\t}\n16\t\n17\tconst PLAN_LABELS: Record<Plan, PlanLabel> = {\n18\t  free: \"Free\",\n19\t  trial: \"Trial\",\n20\t  pro: \"Pro\",\n21\t}\n22\t\n23\tconst TRIAL_AVAILABLE_LABEL =\n24\t  \"Start 7-day Pro trial — Free for 7 days, no card needed\"\n25\t\n26\tfunction formatDate(iso: string | null): string | null {\n27\t  if (!iso) return null\n28\t  const date = new Date(iso)\n29\t  if (Number.isNaN(date.getTime())) return null\n30\t  return date.toLocaleDateString(\"en-US\", {\n31\t    month: \"long\",\n32\t    day: \"numeric\",\n33\t    year: \"numeric\",\n34\t    timeZone: \"UTC\",\n35\t  })\n36\t}\n37\t\n38\texport function deriveAccountView(snapshot: AccountSnapshot): AccountView {\n39\t  const plan: Plan = snapshot.entitlement?.plan ?? \"free\"\n40\t  const planLabel = PLAN_LABELS[plan]\n41\t\n42\t  let dateLine: string | null = null\n43\t  if (plan === \"pro\" && snapshot.subscription) {\n44\t    const sub = snapshot.subscription\n45\t    const cancelAt = formatDate(sub.cancel_at)\n46\t    const renewal = formatDate(sub.current_period_end)\n47\t    if (sub.cancel_at && sub.status === \"active\" && cancelAt) {\n48\t      dateLine = `Pro until ${cancelAt}, will not renew`\n49\t    } else if (renewal) {\n50\t      dateLine = `Renews on ${renewal}`\n51\t    }\n52\t  } else if (plan === \"trial\" && snapshot.proTrial) {\n53\t    const expires = formatDate(snapshot.proTrial.expires_at)\n54\t    if (expires) {\n55\t      dateLine = `Trial expires ${expires}`\n56\t    }\n57\t  }\n58\t\n59\t  const primaryCta: AccountView[\"primaryCta\"] =\n60\t    plan === \"pro\"\n61\t      ? { label: \"Manage subscription\" }\n62\t      : { label: \"Upgrade to Pro\" }\n63\t\n64\t  let trialCta: AccountView[\"trialCta\"] = null\n65\t  if (plan === \"free\") {\n66\t    if (snapshot.proTrial) {\n67\t      const usedDate = formatDate(snapshot.proTrial.started_at)\n68\t      trialCta = {\n69\t        kind: \"used\",\n70\t        label: usedDate ? `Trial used on ${usedDate}` : \"Trial already used\",\n71\t      }\n72\t    } else {\n73\t      trialCta = { kind: \"start\", label: TRIAL_AVAILABLE_LABEL }\n74\t    }\n75\t  }\n76\t\n77\t  return {\n78\t    email: snapshot.email,\n79\t    plan,\n80\t    planLabel,\n81\t    dateLine,\n82\t    primaryCta,\n83\t    trialCta,\n84\t  }\n85\t}\n86\t"}]},"parent_tool_use_id":null,"session_id":"b359056d-8171-4758-80a4-d865a9a6082e","uuid":"a82d2de9-d79c-4ec6-ba49-6426cb5ca7c9","timestamp":"2026-04-26T22:29:22.364Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/cippa/Desktop/fly/locus-landing-page-preview/src/lib/account/derive.ts","content":"import type { AccountSnapshot, Plan } from \"./snapshot\"\n\nexport type PlanLabel = \"Free\" | \"Trial\" | \"Pro\"\n\nexport type AccountView = {\n  email: string\n  plan: Plan\n  planLabel: PlanLabel\n  dateLine: string | null\n  primaryCta: { label: \"Upgrade to Pro\" | \"Manage subscription\" }\n  trialCta:\n    | { kind: \"start\"; label: string }\n    | { kind: \"used\"; label: string }\n    | null\n}\n\nconst PLAN_LABELS: Record<Plan, PlanLabel> = {\n  free: \"Free\",\n  trial: \"Trial\",\n  pro: \"Pro\",\n}\n\nconst TRIAL_AVAILABLE_LABEL =\n  \"Start 7-day Pro trial — Free for 7 days, no card needed\"\n\nfunction formatDate(iso: string | null): string | null {\n  if (!iso) return null\n  const date = new Date(iso)\n  if (Number.isNaN(date.getTime())) return null\n  return date.toLocaleDateString(\"en-US\", {\n    month: \"long\",\n    day: \"numeric\",\n    year: \"numeric\",\n    timeZone: \"UTC\",\n  })\n}\n\nexport function deriveAccountView(snapshot: AccountSnapshot): AccountView {\n  const plan: Plan = snapshot.entitlement?.plan ?? \"free\"\n  const planLabel = PLAN_LABELS[plan]\n\n  let dateLine: string | null = null\n  if (plan === \"pro\" && snapshot.subscription) {\n    const sub = snapshot.subscription\n    const cancelAt = formatDate(sub.cancel_at)\n    const renewal = formatDate(sub.current_period_end)\n    if (sub.cancel_at && sub.status === \"active\" && cancelAt) {\n      dateLine = `Pro until ${cancelAt}, will not renew`\n    } else if (renewal) {\n      dateLine = `Renews on ${renewal}`\n    }\n  } else if (plan === \"trial\" && snapshot.proTrial) {\n    const expires = formatDate(snapshot.proTrial.expires_at)\n    if (expires) {\n      dateLine = `Trial expires ${expires}`\n    }\n  }\n\n  const primaryCta: AccountView[\"primaryCta\"] =\n    plan === \"pro\"\n      ? { label: \"Manage subscription\" }\n      : { label: \"Upgrade to Pro\" }\n\n  let trialCta: AccountView[\"trialCta\"] = null\n  if (plan === \"free\") {\n    if (snapshot.proTrial) {\n      const usedDate = formatDate(snapshot.proTrial.started_at)\n      trialCta = {\n        kind: \"used\",\n        label: usedDate ? `Trial used on ${usedDate}` : \"Trial already used\",\n      }\n    } else {\n      trialCta = { kind: \"start\", label: TRIAL_AVAILABLE_LABEL }\n    }\n  }\n\n  return {\n    email: snapshot.email,\n    plan,\n    planLabel,\n    dateLine,\n    primaryCta,\n    trialCta,\n  }\n}\n","numLines":86,"startLine":1,"totalLines":86}}}
